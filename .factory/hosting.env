# hosting 平台配置（ADR-008；forge.json 随 forge 退役迁移至此）
# 用法：链入口 source 本文件（bash：source .factory/hosting.env && .factory/fix-issue.sh ...；
# cron/LaunchAgent：EnvironmentVariables 或 BASH_ENV 指向本文件路径）
# 令牌不入库：GH_TOKEN / GITHUB_TOKEN 在 shell profile 或 gh CLI 登录态提供
export FACTORY_HOSTING=github
export FACTORY_BASE_BRANCH=main             # 链基线（两级回退 env 级）
